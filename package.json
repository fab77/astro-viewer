{
  "name": "astro-viewer",
  "description": "3D scientific visualization engine for astronomical and Earth observation data, supporting HiPS, FITS, TAP, ADQL, footprints and WebGL-based spatial exploration.",
  "version": "3.9.0-snapshot",
  "keywords": [
    "astronomy",
    "astrophysics",
    "earth-observation",
    "scientific-visualization",
    "3d",
    "webgl",
    "hips",
    "healpix",
    "fits",
    "wcs",
    "tap",
    "adql",
    "footprints",
    "geospatial"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "Fabrizio Giordano (fab77)",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://github.com/fab77/astro-viewer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fab77/astro-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/fab77/astro-viewer/issues",
    "email": "fabriziogiordano77@gmail.com"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib-esm/index.d.ts",
      "import": "./lib-esm/index.js",
      "require": "./dist/astroviewer.cjs"
    },
    "./package.json": "./package.json"
  },
  "module": "./lib-esm/index.js",
  "main": "./dist/astroviewer.cjs",
  "types": "./lib-esm/index.d.ts",
  "unpkg": "./dist/astroviewer.min.js",
  "jsdelivr": "./dist/astroviewer.min.js",
  "files": [
    "lib-esm/",
    "dist/",
    "README.md",
    "LICENSE.md",
    "LICENSE-AGPL.md",
    "LICENSE-COMMERCIAL.md",
    "DEPENDENCY-LICENSING.md",
    "package.json"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "shx rm -rf dist lib-esm",
    "dev": "npm run clean && tsc && webpack --mode=development --watch --progress",
    "dev:lib": "tsc -w -p tsconfig.build.json",
    "prod": "npm run clean && tsc -p tsconfig.build.json && webpack --mode=production && npm run web",
    "build": "npm run clean && tsc -p tsconfig.build.json && webpack --mode=production",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "web": "shx rm -rf public && shx mkdir -p public/javascripts public/css public/test-data && cp dist/* public/javascripts/ && cp -R src/html/javascripts/* public/javascripts/ && cp -R src/html/css/* public/css/ && cp -R src/html/test-data/* public/test-data/ && cp src/html/*.html public/",
    "start-server": "npm run build && npm run web && node scripts/serve_test_ui.mjs",
    "all": "npm run start-server",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^18.19.76",
    "canvas": "3.1.0",
    "jest": "^29.0.0",
    "shx": "^0.3.4",
    "terser-webpack-plugin": "^5.6.1",
    "ts-jest": "^29.0.0",
    "ts-loader": "^9.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0"
  },
  "dependencies": {
    "astrospatial-core": "^0.4.1",
    "cross-fetch": "^3.2.0",
    "gl-matrix": "^3.4.4",
    "jsfitsio": "^3.1.0",
    "wcslight": "^3.1.4"
  },
  "browser": {
    "fs": false,
    "node:fs/promises": false,
    "node:fs": false,
    "fs/promises": false
  }
}
