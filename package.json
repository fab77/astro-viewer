{
  "name": "astro-viewer",
  "description": "Astrobrowser 3d engine.",
  "version": "1.5.0-snapshot",
  "keywords": [
    "HiPS",
    "HiPS cutout",
    "HiPS visualisation",
    "astronomy",
    "astrophysics",
    "science",
    "data format",
    "webGL",
    "3D"
  ],
  "author": "Fabrizio Giordano (fab77)",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/fab77/astro-viewer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fab77/astro-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/fab77/astro-viewer/issues",
    "email": "fabriziogiordano77@gmail.com"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib-esm/index.d.ts",
      "import": "./lib-esm/index.js",
      "require": "./dist/astroviewer.cjs"
    }
  },
  "module": "./lib-esm/index.js",
  "main": "./dist/astroviewer.cjs",
  "types": "./lib-esm/index.d.ts",
  "unpkg": "dist/astroviewer.min.js",
  "jsdelivr": "dist/astroviewer.min.js",
  "files": [
    "lib-esm/",
    "dist"
  ],
  "prepublishOnly": "npm run build:prod",
  "sideEffects": false,
  "scripts": {
    "clean": "shx rm -rf dist lib-esm",
    "dev": "npm run clean && tsc && webpack --mode=development --watch --progress; cp dist/* webtest/",
    "prod": "npm run clean && tsc && webpack --mode=production && npm run web",
    "build": "npm run clean && tsc && webpack --mode=production",
    "web": "cp dist/* public/javascripts/; cp -R src/html/javascripts/ public/javascripts/; cp -R src/html/css/ public/css/; cp src/html/*.html public/",
    "start-server": "npx http-server public",
    "all": "npm run clean; npm run prod; npm run start-server",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^18.19.76",
    "jest": "^29.0.0",
    "shx": "^0.3.4",
    "ts-jest": "^29.0.0",
    "ts-loader": "^9.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0"
  },
  "dependencies": {
    "canvas": "3.1.0",
    "gl-matrix": "^3.3.0",
    "jsfitsio": "1.2.3",
    "healpixjs": "^1.3.0",
    "wcslight": "1.3.0",
    "cross-fetch": "^3.1.5"
  },
  "browser": {
    "fs": false,
    "node:fs/promises": false,
    "node:fs": false,
    "fs/promises": false
  }
}
