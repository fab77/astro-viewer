# Minimal low-poly satellite marker for AstroViewer dev demos.
# Local axes: +Y forward, +Z radial/up, +X right.

o SimpleSatellite

# Main bus, rectangular box
v -0.35 -0.45 -0.22
v  0.35 -0.45 -0.22
v  0.35  0.45 -0.22
v -0.35  0.45 -0.22
v -0.35 -0.45  0.22
v  0.35 -0.45  0.22
v  0.35  0.45  0.22
v -0.35  0.45  0.22

# Left solar panel. Single plane; SatelliteObjectGL uses two-sided lighting.
v -1.55 -0.55  0.00
v -0.45 -0.55  0.00
v -0.45  0.55  0.00
v -1.55  0.55  0.00

# Right solar panel. Single plane; SatelliteObjectGL uses two-sided lighting.
v  0.45 -0.55  0.00
v  1.55 -0.55  0.00
v  1.55  0.55  0.00
v  0.45  0.55  0.00

vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn  0.0 -1.0  0.0
vn  1.0  0.0  0.0
vn  0.0  1.0  0.0
vn -1.0  0.0  0.0
vn  0.0  0.0  1.0

# Bus faces
f 1//1 4//1 3//1 2//1
f 5//2 6//2 7//2 8//2
f 1//3 2//3 6//3 5//3
f 2//4 6//4 7//4 3//4
f 3//5 7//5 8//5 4//5
f 4//6 1//6 5//6 8//6

# Solar panel faces
f 9//7 10//7 11//7 12//7
f 13//7 14//7 15//7 16//7
